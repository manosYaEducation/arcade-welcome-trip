rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'asus.alphadocere@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 3. Validation Blueprints (Synced with firebase-blueprint.json)
    function isValidEventConfig(data) {
      return data.keys().hasAll([
          'eventName',
          'subtitle',
          'venue',
          'gameDurationSeconds',
          'badgeTitle',
          'badgeAccentColor',
          'badgeFooterNote',
          'whatsappTemplate',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'eventName',
          'subtitle',
          'venue',
          'gameDurationSeconds',
          'badgeTitle',
          'badgeAccentColor',
          'badgeFooterNote',
          'whatsappTemplate',
          'updatedAt'
        ]) &&
        data.eventName is string && data.eventName.size() >= 2 && data.eventName.size() <= 120 &&
        data.subtitle is string && data.subtitle.size() <= 200 &&
        data.venue is string && data.venue.size() >= 1 && data.venue.size() <= 120 &&
        data.gameDurationSeconds is number && data.gameDurationSeconds >= 10 && data.gameDurationSeconds <= 120 &&
        data.badgeTitle is string && data.badgeTitle.size() >= 2 && data.badgeTitle.size() <= 80 &&
        data.badgeAccentColor is string && data.badgeAccentColor.size() >= 4 && data.badgeAccentColor.size() <= 20 &&
        data.badgeFooterNote is string && data.badgeFooterNote.size() <= 160 &&
        data.whatsappTemplate is string && data.whatsappTemplate.size() >= 5 && data.whatsappTemplate.size() <= 500 &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidPrize(data) {
      return data.keys().hasAll(['label', 'stock', 'color', 'updatedAt']) &&
        data.keys().hasOnly(['label', 'stock', 'color', 'updatedAt']) &&
        data.label is string && data.label.size() >= 1 && data.label.size() <= 80 &&
        data.stock is number && data.stock >= 0 && data.stock <= 100000 &&
        data.color is string && data.color.size() >= 4 && data.color.size() <= 20 &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidAttendee(data) {
      return data.keys().hasAll([
          'authorUid',
          'name',
          'role',
          'organization',
          'wordForCloud',
          'checkedInAt',
          'arcadeScore',
          'maxCombo',
          'playedArcade',
          'prizeWon',
          'isPublic',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'authorUid',
          'name',
          'role',
          'organization',
          'wordForCloud',
          'checkedInAt',
          'arcadeScore',
          'maxCombo',
          'playedArcade',
          'prizeWon',
          'isPublic',
          'createdAt',
          'updatedAt'
        ]) &&
        data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
        data.authorUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.role is string && data.role.size() >= 1 && data.role.size() <= 80 &&
        data.organization is string && data.organization.size() <= 100 &&
        data.wordForCloud is string && data.wordForCloud.size() >= 1 && data.wordForCloud.size() <= 60 &&
        data.checkedInAt is string && data.checkedInAt.size() >= 1 && data.checkedInAt.size() <= 40 &&
        data.arcadeScore is number && data.arcadeScore >= 0 && data.arcadeScore <= 1000000 &&
        data.maxCombo is number && data.maxCombo >= 1 && data.maxCombo <= 10 &&
        data.playedArcade is bool &&
        data.prizeWon is string && data.prizeWon.size() <= 100 &&
        data.isPublic is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidAttendeeContact(data) {
      return data.keys().hasAll(['authorUid', 'phone', 'updatedAt']) &&
        data.keys().hasOnly(['authorUid', 'phone', 'updatedAt']) &&
        data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
        data.authorUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.phone is string && data.phone.size() <= 30 &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidEventHistory(data) {
      return data.keys().hasAll([
          'eventName',
          'venue',
          'closedAt',
          'attendeeCount',
          'topScore',
          'topPlayerName',
          'prizesAwardedCount',
          'attendeesSummary',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'eventName',
          'venue',
          'closedAt',
          'attendeeCount',
          'topScore',
          'topPlayerName',
          'prizesAwardedCount',
          'attendeesSummary',
          'createdAt'
        ]) &&
        data.eventName is string && data.eventName.size() >= 1 && data.eventName.size() <= 120 &&
        data.venue is string && data.venue.size() >= 1 && data.venue.size() <= 120 &&
        data.closedAt is string && data.closedAt.size() >= 1 && data.closedAt.size() <= 60 &&
        data.attendeeCount is number && data.attendeeCount >= 0 && data.attendeeCount <= 100000 &&
        data.topScore is number && data.topScore >= 0 && data.topScore <= 10000000 &&
        data.topPlayerName is string && data.topPlayerName.size() <= 100 &&
        data.prizesAwardedCount is number && data.prizesAwardedCount >= 0 && data.prizesAwardedCount <= 100000 &&
        data.attendeesSummary is string && data.attendeesSummary.size() <= 15000 &&
        data.createdAt is timestamp && data.createdAt == request.time;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'createdAt']) &&
        data.keys().hasOnly(['email', 'createdAt']) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
        data.createdAt is timestamp && data.createdAt == request.time;
    }

    // 4. Collection Rules
    match /eventConfig/{configId} {
      allow get: if isSignedIn() && isValidId(configId);
      allow list: if isSignedIn() && resource.data.gameDurationSeconds >= 10;
      allow create, update: if isSignedIn() && isValidId(configId) && isValidEventConfig(incoming()) && isAdmin();
      allow delete: if isSignedIn() && isValidId(configId) && isAdmin();
    }

    match /prizes/{prizeId} {
      allow get: if isSignedIn() && isValidId(prizeId);
      allow list: if isSignedIn() && resource.data.stock >= 0;
      allow create, update: if isSignedIn() && isValidId(prizeId) && isValidPrize(incoming()) && isAdmin();
      allow delete: if isSignedIn() && isValidId(prizeId) && isAdmin();
    }

    match /attendees/{attendeeId} {
      allow get: if isSignedIn() && isValidId(attendeeId) && (existing().isPublic == true || existing().authorUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.isPublic == true || resource.data.authorUid == request.auth.uid);

      allow create: if isSignedIn() &&
        isValidId(attendeeId) &&
        isValidAttendee(incoming()) &&
        (incoming().authorUid == request.auth.uid || isAdmin()) &&
        incoming().createdAt == request.time &&
        (incoming().prizeWon == '' || isAdmin());

      allow update: if isSignedIn() &&
        isValidId(attendeeId) &&
        isValidAttendee(incoming()) &&
        incoming().authorUid == existing().authorUid &&
        incoming().createdAt == existing().createdAt && (
          // Action 1: Attendee updates their own arcade score (cannot touch prizeWon)
          (
            existing().authorUid == request.auth.uid &&
            incoming().prizeWon == existing().prizeWon &&
            incoming().diff(existing()).affectedKeys().hasOnly(['arcadeScore', 'maxCombo', 'playedArcade', 'updatedAt'])
          ) ||
          // Action 2: Admin assigns prize from Tombola or updates attendee
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['prizeWon', 'arcadeScore', 'maxCombo', 'playedArcade', 'updatedAt'])
          )
        );

      allow delete: if isSignedIn() && isValidId(attendeeId) && isAdmin();
    }

    // Isolated PII Contact Collection (Phone / WhatsApp) - Restricted strictly to Owner or Admin
    match /attendeeContacts/{attendeeId} {
      allow get: if isSignedIn() && isValidId(attendeeId) && (existing().authorUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
        isValidId(attendeeId) &&
        isValidAttendeeContact(incoming()) &&
        (incoming().authorUid == request.auth.uid || isAdmin());

      allow update: if isSignedIn() &&
        isValidId(attendeeId) &&
        isValidAttendeeContact(incoming()) &&
        incoming().authorUid == existing().authorUid && (
          (existing().authorUid == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['phone', 'updatedAt'])) ||
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['phone', 'updatedAt']))
        );

      allow delete: if isSignedIn() && isValidId(attendeeId) && (existing().authorUid == request.auth.uid || isAdmin());
    }

    // Historical Sessions Collection (Admin Only, Immutable once archived)
    match /eventHistory/{historyId} {
      allow get: if isSignedIn() && isValidId(historyId) && isAdmin();
      allow list: if isSignedIn() && resource.data.attendeeCount >= 0 && isAdmin();
      allow create: if isSignedIn() && isValidId(historyId) && isValidEventHistory(incoming()) && isAdmin();
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(historyId) && isAdmin();
    }

    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if false;
      allow create: if isSignedIn() && isValidId(adminUid) && isValidAdminUser(incoming()) && isAdmin();
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(adminUid) && isAdmin();
    }
  }
}
