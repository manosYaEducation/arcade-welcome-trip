# GEMINI_API_KEY: Required if server-side Gemini AI features are used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where the application is hosted.
APP_URL="http://localhost:3000"

# VITE_EVENT_DEFAULT_NAME: Default event title shown on welcome screen.
VITE_EVENT_DEFAULT_NAME="Arcade Welcome Trip"

# VITE_GAME_DURATION_SECONDS: Default arcade round duration in seconds.
VITE_GAME_DURATION_SECONDS="30"
